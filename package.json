{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run dev -w apps/orbit",
    "dev:voyager": "npm run dev -w apps/voyager",
    "dev:pulsar": "npm run dev -w apps/pulsar",
    "build": "npm run build -w apps/orbit",
    "build:voyager": "npm run build -w apps/voyager",
    "build:pulsar": "npm run build -w apps/pulsar",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check -w apps/orbit"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.15.47": true,
    "unrs-resolver@1.12.2": true
  }
}
