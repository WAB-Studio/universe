      "checkConstraints": {
        "commitments_weekdays_for_weekdays": {
          "name": "commitments_weekdays_for_weekdays",
          "value": "case when \"goals\".\"commitments\".\"cadence_kind\" = 'weekdays' then coalesce(array_length(\"goals\".\"commitments\".\"cadence_weekdays\", 1), 0) > 0 else \"goals\".\"commitments\".\"cadence_weekdays\" is null end"
        },
        "commitments_weekdays_iso_range": {
          "name": "commitments_weekdays_iso_range",
          "value": "\"goals\".\"commitments\".\"cadence_weekdays\" <@ array[1, 2, 3, 4, 5, 6, 7]::smallint[]"
        },
        "commitments_n_for_counted_kinds": {
          "name": "commitments_n_for_counted_kinds",
          "value": "(\"goals\".\"commitments\".\"cadence_kind\" in ('times_per_week', 'every_n_days', 'times_per_month')) = (\"goals\".\"commitments\".\"cadence_n\" is not null and \"goals\".\"commitments\".\"cadence_n\" > 0)"
        },
        "commitments_quantity_for_quantity": {
          "name": "commitments_quantity_for_quantity",
          "value": "(\"goals\".\"commitments\".\"satisfaction\" = 'quantity') = (\"goals\".\"commitments\".\"target_quantity\" is not null and \"goals\".\"commitments\".\"unit\" is not null)"
        },
        "commitments_source_for_evidence": {
          "name": "commitments_source_for_evidence",
          "value": "(\"goals\".\"commitments\".\"satisfaction\" = 'evidence') = (\"goals\".\"commitments\".\"source_id\" is not null and \"goals\".\"commitments\".\"threshold\" is not null and \"goals\".\"commitments\".\"threshold\" >= 1)"
        }
