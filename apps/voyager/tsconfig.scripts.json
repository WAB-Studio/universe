{
  // `next build` typechecks `tsconfig.json`, and Vercel installs voyager's
  // workspace alone — so a script reaching for a library orbit declares
  // (`exceljs`, hoisted to the root here and in CI) fails the production
  // build. Excluded there, checked here: this config runs under
  // `npm run typecheck`, where the hoist resolves.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    // `next-env.d.ts` pulled these into the parent; this config drops it.
    "types": ["node"]
  },
  "include": ["scripts/build-concreteness.ts"],
  "exclude": ["node_modules", "private"]
}
